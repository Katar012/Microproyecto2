global
    log stdout format raw local0
    stats socket /tmp/haproxy.sock mode 666 level admin

defaults
    log global
    stats enable
    stats refresh 10s
    stats uri /stats
    mode http

frontend http_front
    bind *:80

    # ACLs para microservicios
    acl is_users    path_beg /api/users /api/login /api/register
    acl is_products path_beg /api/products
    acl is_orders   path_beg /api/orders

    # Enrutamiento
    use_backend users_back    if is_users
    use_backend products_back if is_products
    use_backend orders_back   if is_orders

    default_backend frontend_back
# 2. Frontend microservicios
backend frontend_back
    balance roundrobin
    server frontend1 192.168.100.3:5001 check

# 3. Backend de Usuarios
backend users_back
    balance roundrobin
    http-response set-header X-Served-By %s
    server users1 192.168.100.3:3001 check
    server users2 192.168.100.3:3011 check

# 4. Backend de Productos
backend products_back
    balance roundrobin
    http-response set-header X-Served-By %s
    server products1 192.168.100.3:3002 check
    server products2 192.168.100.3:3012 check

# 5. Backend de Ordenes
backend orders_back
    balance roundrobin
    http-response set-header X-Served-By %s
    server orders1 192.168.100.3:3003 check
    server orders2 192.168.100.3:3013 check

# 6. Dashboard de Estadisticas en puerto 8081 (Cambiado para evitar conflicto)
listen stats
    bind *:8081
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s
    stats auth admin:admin123
