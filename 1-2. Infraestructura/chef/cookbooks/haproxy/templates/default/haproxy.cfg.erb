#---------------------------------------------------------------------
# /etc/haproxy/haproxy.cfg
# GENERADO POR CHEF (cookbook haproxy, plantilla haproxy.cfg.erb)
# No editar a mano en la VM: cualquier cambio se pierde en el siguiente
# aprovisionamiento. Editar la plantilla/atributos y correr terraform apply.
#---------------------------------------------------------------------

global
    log /dev/log local0
    maxconn 2048
    # Socket de administracion (API en caliente): socat stdio /run/haproxy/admin.sock
    stats socket /run/haproxy/admin.sock mode 660 level admin
    user haproxy
    group haproxy

defaults
    log global
    mode http
    option httplog
    option dontlognull
    option forwardfor
    # Si un servidor no responde, reintenta y manda la peticion a OTRO servidor
    # del backend (el cliente no ve el error mientras HAProxy detecta la caida)
    retries 3
    option redispatch
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    timeout check   2s

# 1. Frontend de entrada en puerto 80 (punto de entrada UNICO de la aplicacion)
frontend http_front
    bind *:80

    # Reglas ACL segun prefijo de ruta
<% @services.each_key do |svc| %>
    acl is_<%= svc %> path_beg /api/<%= svc %>
<% end %>

    # Enrutamiento hacia cada backend
<% @services.each_key do |svc| %>
    use_backend <%= svc %>_back if is_<%= svc %>
<% end %>

    # Cualquier otra ruta -> 404 explicando las rutas validas
    default_backend not_found

# 2. Backends: uno por microservicio, balanceo <%= @balance %> + health check HTTP
<% @services.each do |svc, cfg| %>
backend <%= svc %>_back
    balance <%= @balance %>
    option httpchk GET /health
    http-check expect status 200
    # Cabecera para ver en "curl -i" que servidor respondio
    http-response set-header X-Backend-Server %[srv_name]
<%   (1..cfg['instances']).each do |i| %>
    server <%= svc %><%= i %> <%= @backend_ip %>:<%= cfg['port'] + (i - 1) * @port_step %> check <%= @check %>
<%   end %>

<% end %>
backend not_found
    http-request return status 404 content-type text/plain string "404 - Ruta no definida en HAProxy. Rutas validas: <%= @services.keys.map { |s| "/api/#{s}" }.join(', ') %>"

# 3. Dashboard de Estadisticas en puerto <%= @stats_port %> (protegido con usuario y contraseña)
listen stats
    bind *:<%= @stats_port %>
    mode http
    stats enable
    stats uri /stats
    stats refresh 5s
    stats show-legends
    stats auth <%= @stats_user %>:<%= @stats_password %>
    # Permite poner servidores en MAINT/DRAIN desde el propio dashboard
    stats admin if TRUE
