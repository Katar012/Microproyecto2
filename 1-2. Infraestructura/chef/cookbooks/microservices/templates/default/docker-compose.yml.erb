# ==============================================================================
# /opt/microapp/docker-compose.yml
# Generado por Chef (cookbook: microservices, template: docker-compose.yml.erb)
# Define declarativamente los microservicios con Docker Compose
# ==============================================================================

services:
<% @services.each do |svc, cfg| %>
  # ----------------------------------------------------------------------------
  # Microservicio: <%= svc %> (Puerto interno: <%= cfg['port'] %>)
  # ----------------------------------------------------------------------------
<%   (1..cfg['instances']).each do |i| %>
<%     host_port = cfg['port'] + (i - 1) * @port_step %>
<%     name = "#{svc}-service-#{i}" %>
  <%= name %>:
    image: <%= @image %>
    container_name: <%= name %>
    restart: always
    command:
      - "-listen=:<%= cfg['port'] %>"
      - "-text=<%= svc %>-service | instancia: <%= name %> | puerto contenedor: <%= cfg['port'] %> | puerto host: <%= host_port %>\n"
    ports:
      - "<%= host_port %>:<%= cfg['port'] %>"
    labels:
      microapp.service: "<%= svc %>"
      microapp.instance: "<%= i %>"
      microapp.managed_by: "chef-docker-compose"

<%   end %>
<% end %>
